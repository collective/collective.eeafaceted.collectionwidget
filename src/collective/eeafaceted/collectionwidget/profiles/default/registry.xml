<?xml version="1.0"?>
<registry>

  <!-- icon of the DashboardCollection type (icon_expr) -->
  <record name="plone.icon.contenttype/dashboardcollection">
    <field type="plone.registry.field.TextLine">
      <title>DashboardCollection</title>
    </field>
    <value>++resource++collective.eeafaceted.collectionwidget/dashboardcollection.png</value>
  </record>

  <!-- DashboardCollection forms -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/collectionwidget">
    <value key="enabled">True</value>
    <value key="csscompilation">++resource++collective.eeafaceted.collectionwidget/collective.eeafaceted.collectionwidget.css</value>
    <value key="expression"></value>
  </records>

  <!-- collection-link widget: after eea.facetednavigation's bundles, deferred as they are -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/faceted.collectionwidget.view">
    <value key="enabled">True</value>
    <value key="jscompilation">++resource++collective.eeafaceted.collectionwidget.widgets.view.js</value>
    <value key="csscompilation">++resource++collective.eeafaceted.collectionwidget.view.css</value>
    <value key="expression"></value>
    <value key="depends">faceted.view</value>
    <value key="load_async">False</value>
    <value key="load_defer">True</value>
  </records>

  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/faceted.collectionwidget.edit">
    <value key="enabled">True</value>
    <value key="jscompilation">++resource++collective.eeafaceted.collectionwidget.widgets.edit.js</value>
    <value key="expression"></value>
    <value key="depends">faceted.edit</value>
    <value key="load_async">False</value>
    <value key="load_defer">True</value>
  </records>

</registry>
